# Test Environment Variables
NODE_ENV=test
PORT=3002

# Database connection (test database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tlog_test_db
DB_USER=app
DB_PASSWORD=secret
DATABASE_URL=postgresql://app:secret@localhost:5432/tlog_test_db

# Application
ROUND_DURATION=60
COOLDOWN_DURATION=30

# Authentication
JWT_SECRET=test-super-secret-jwt-token-for-tlog-app
JWT_EXPIRES_IN=24h

# Redis Configuration (test instance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1  # Use different DB for tests

# Batching Configuration (faster for testing)
BATCH_SIZE=10  # Lower threshold for faster testing
BATCH_TIMEOUT_SECONDS=2  # Shorter timeout for testing
INSTANCE_ID=test-instance
BATCH_LOCK_TTL_MS=1000  # Shorter lock TTL for testing
