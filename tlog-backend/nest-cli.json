{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "index",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "cache/scripts/*.lua",
        "outDir": "dist/src"
      }
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "skipAutoHttpCode": false
        }
      }
    ]
  }
}
