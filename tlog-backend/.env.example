NODE_ENV=development
PORT=3001
ROUND_DURATION=60
COOLDOWN_DURATION=30

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tlog_db
DB_USER=app
DB_PASSWORD=secret


# Authentication
JWT_SECRET=super-secret-jwt-token-for-tlog-app

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secretpass
REDIS_DB=0

# Batching Configuration
BATCH_SIZE=100
BATCH_TIMEOUT_SECONDS=10
INSTANCE_ID=dev-1
BATCH_LOCK_TTL_MS=5000
